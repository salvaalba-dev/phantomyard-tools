# Review-only drop-in for phantomdocs-matrix-alma@.service.
# Install only with a separately authorized window and verified root-owned files.
# Remove the .example suffix when installing. The filename must sort after
# release-3ee74fe.conf if retained. Verify effective ExecStart and drop-ins.
[Service]
Environment=PYTHONPATH=
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
ExecStart=
ExecStart=/usr/bin/python3.12 -I -S -B /usr/local/lib/phantomdocs-matrix-pr72/bootstrap.py
