[Unit]
Description=Refresh the Nostr bridge policy from PhantomOrg
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/phantomdocs/bridge-policy/venv/bin/python -m phantomdocs.workflow_bridge_policy --source /srv/example-policy/source.yaml --destination /srv/example-policy/bridge.yaml --destination /srv/example-policy/docs.yaml --policy-lock /etc/phantomdocs/policy.lock --resolver /opt/example-bridge/org-routing.js --unit example-bridge.service
