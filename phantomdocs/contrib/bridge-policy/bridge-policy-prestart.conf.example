[Service]
ExecStartPre=/opt/phantomdocs/bridge-policy/venv/bin/python -m phantomdocs.workflow_bridge_policy --source /srv/example-policy/source.yaml --destination /srv/example-policy/bridge.yaml --destination /srv/example-policy/docs.yaml --policy-lock /etc/phantomdocs/policy.lock --resolver /opt/example-bridge/org-routing.js --unit example-bridge.service --prestart
