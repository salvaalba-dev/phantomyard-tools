[Service]
ExecStartPre=/opt/phantomdocs/bridge-policy/venv/bin/python -m phantomdocs.workflow_bridge_policy --source /root/proyeccion/org-live.yaml --destination /opt/jitsi-nostr-bridge/org.yaml --policy-lock /etc/phantomdocs/policy.lock --resolver /opt/jitsi-nostr-bridge/org-routing.js --unit jitsi-nostr-bridge.service --prestart
